# ==========================================
# Root .gitignore for extension_mtl_komik
# ==========================================

# Environment & Sensitive Credentials
.env
.env.*
.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa
id_rsa.pub
auth.json

# Dependencies
vendor/
node_modules/
backend/vendor/
backend/node_modules/
extension/node_modules/

# Python Virtual Environments & Cache
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
backend/python_ocr/venv/
backend/python_ocr/.venv/
backend/python_ocr/__pycache__/
python_ocr/venv/
python_ocr/.venv/
python_ocr/__pycache__/

# Laravel Storage & Framework Cache
backend/storage/*.key
backend/storage/app/public/comics/*
backend/storage/app/public/temp_downloads/*
backend/storage/app/public/temp_extension/*
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/framework/testing/*
backend/storage/logs/*.log
backend/bootstrap/cache/*.php

# Temporary Test & Scratch Scripts (contains local API keys/tokens)
backend/test_*.php
backend/test_*.py
test_*.php
test_*.py
backend/tests/manual/
tests/manual/
backend/test.php

# Database & SQLite
*.sqlite
*.sqlite3
*.db
backend/database/*.sqlite

# Logs & Temporary Files
*.log
*.tmp
*.temp
*.bak
*.cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Chrome Extension build / zip packages
*.zip
*.crx
extension/*.zip
extension/*.crx
